# ---- WAJIB di production / Vercel ----
SECRET=ganti-dengan-string-acak-panjang        # penanda tangan token login (mis. hasil: openssl rand -hex 32)
KV_REST_API_URL=                               # dari Upstash Redis (Vercel Marketplace mengisinya otomatis)
KV_REST_API_TOKEN=
ADMIN_EMAIL=admin@restoku.com                  # akun admin pertama (dibuat sekali saat database masih kosong)
ADMIN_PASSWORD=ganti-password-kuat

# ---- Opsional ----
DEMO_MODE=false                                # true = data contoh + akun demo kasir/dapur + tampil di halaman login (untuk portofolio)
APP_TIMEZONE=Asia/Jakarta                      # zona waktu laporan & batas "hari ini"
RESTO_NAME=Restoku
RESTO_ADDRESS=Jl. Contoh No. 1, Surabaya
DB_PREFIX=restoku:
PORT=3001                                      # hanya untuk server lokal/VPS
